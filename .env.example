EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the "anon" / "public" key from Supabase Dashboard → Settings → API (NOT service_role)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets (set via: supabase secrets set KEY=value) ──────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Beyond Presence — https://beyondpresence.ai
BEYOND_PRESENCE_API_KEY=bp_...
# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...
LIVEKIT_URL=wss://your-project.livekit.cloud
